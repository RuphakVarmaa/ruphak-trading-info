// Dashboard Worker (Next.js via @opennextjs/cloudflare).
// All engine data (state, signals, events, orders, P&L) and admin actions (arm, kill
// switch, mode) go through the engine Worker's EngineAdmin RPC entrypoint, so D1 and
// every trading secret stay inside the engine Worker.
// Create the R2 bucket once with: npx wrangler r2 bucket create ruphak-next-cache
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruphak-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "ruphak-dashboard" },
    { "binding": "ENGINE", "service": "ruphak-engine", "entrypoint": "EngineAdmin" }
  ],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ruphak-next-cache" }],
  "vars": {
    "ENGINE_MOCK": "0"
  }
}
