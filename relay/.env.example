# Order relay configuration.
# Local/Docker: copy to relay/.env. systemd: copy to /etc/ruphak-relay.env.
# Either way: chmod 600, never commit it. Comments must be on their own lines
# (systemd EnvironmentFile and Docker env_file do not strip inline comments).

# ---- server -------------------------------------------------------------------
# Docker sets RELAY_HOST=0.0.0.0 inside the container (docker-compose.yml).
RELAY_HOST=127.0.0.1
RELAY_PORT=8790
RELAY_DB_PATH=./data/relay.sqlite
# debug | info | warn | error
RELAY_LOG_LEVEL=info

# ---- request authentication ---------------------------------------------------
# Shared with the engine Worker secret of the same name. Generate: openssl rand -hex 32
# (at least 32 characters when RELAY_LIVE=true).
RELAY_HMAC_SECRET=
# Cloudflare Access: team name (or <team>.cloudflareaccess.com) and the Access
# application's Application Audience (AUD) tag. Set both, or leave both empty.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---- Groww (API key of type TOTP from https://groww.in/trade-api/api-keys) ----
GROWW_API_KEY=
# The base32 TOTP secret shown when the key is created (not a 6-digit code).
GROWW_TOTP_SECRET=
# GROWW_BASE_URL=https://api.groww.in/v1
# GROWW_TIMEOUT_MS=8000

# ---- switches -----------------------------------------------------------------
# false = shadow mode: every order is rejected with reason "relay not live".
RELAY_LIVE=false
# true = enable the read-only GET /v1/groww/* data passthrough.
RELAY_DATA_PROXY=false

# ---- hard caps (enforced here even if the engine is compromised) ---------------
ALLOWED_UNDERLYINGS=NIFTY,SENSEX
PRODUCT_ALLOWLIST=MIS
MAX_LOTS_PER_ORDER=2
MAX_ORDERS_PER_DAY=12
# Entries (and SELLs that are not pure exits), Mon-Fri, IST, end exclusive.
TRADING_WINDOW_IST=09:16-15:12
# SELL orders that only reduce a long stay allowed until this time.
EXIT_WINDOW_END_IST=15:25
ALLOW_SHORT=false
MAX_PREMIUM_PER_ORDER_INR=25000
MAX_DAILY_PREMIUM_INR=60000
# The relay's own lot sizes; an order with a different lotSize is rejected.
# Update after NSE/BSE lot revisions, or set to "off" to trust the engine.
LOT_SIZES=NIFTY:65,SENSEX:20
# Weekday exchange holidays (YYYY-MM-DD, comma separated). Unset = built-in 2026
# NSE/BSE list; empty = none. Replace each December from the exchange circulars.
# MARKET_HOLIDAYS=2026-01-15,2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25
# Minimum spacing between Groww order calls (create/modify/cancel), >= 200.
# ORDER_MIN_INTERVAL_MS=250

# ---- docker-compose only --------------------------------------------------------
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > install command).
TUNNEL_TOKEN=
