// Trading engine Worker: Durable Objects (trading loop, ingestion), cron jobs, the
// event-scoring queue consumer, and the EngineAdmin RPC entrypoint used by the dashboard.
// Resource IDs are placeholders; see README "Cloudflare setup" for the create commands.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ruphak-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  // Public workers.dev URL for /ops/* (POST, Bearer ADMIN_TOKEN) and GET /health (phase and heartbeat only).
  // The Telegram webhook ignores requests without the configured secret and chat ID.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "limits": { "cpu_ms": 60000 },
  // Cron day-of-week: Cloudflare numbers Sunday as 1, so weekdays are spelled MON-FRI.
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "1-59/2 3-10 * * MON-FRI",
      "* 3-10 * * MON-FRI",
      "30 2 * * MON-FRI",
      "40 2 * * MON-FRI",
      "0 3 * * MON-FRI",
      "30 10 * * MON-FRI",
      "30 14 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ENGINE_DO", "class_name": "TradingEngineDO" },
      { "name": "INGEST_DO", "class_name": "IngestDO" },
      { "name": "BACKTEST_DO", "class_name": "BacktestDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TradingEngineDO", "IngestDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BacktestDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruphak-trading",
      "database_id": "caa9f5cb-a414-414a-8ec3-e68e11fa1137",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "4e99b0bc3d9d4dfb83ddc4edcddcdccc" }],
  "queues": {
    "producers": [{ "binding": "SCORE_QUEUE", "queue": "events-to-score" }],
    "consumers": [
      {
        "queue": "events-to-score",
        "max_batch_size": 10,
        "max_batch_timeout": 20,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "events-to-score-dlq"
      },
      // Messages that failed 3 times are scored with the lexicon scorer only.
      { "queue": "events-to-score-dlq", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 1 }
    ]
  },
  // Optional R2 archive for dated instrument masters and backtest results. To enable it, add
  //   "r2_buckets": [{ "binding": "R2", "bucket_name": "ruphak-data" }]
  // and create the bucket (npx wrangler r2 bucket create ruphak-data).
  // Workers AI runs the news scorer (GLM-5.3 by default) with no API key inside the Worker.
  "ai": { "binding": "AI" },
  "vars": {
    "ENGINE_ENV": "prod",
    "LIVE_TRADING": "false",
    "GROWW_DATA_VIA_RELAY": "false",
    // News scorer: "workers-ai" (AI binding) or "anthropic" (needs the ANTHROPIC_API_KEY secret).
    "LLM_PROVIDER": "workers-ai",
    "LLM_MODEL": "@cf/zai-org/glm-5.3",
    "LLM_EFFORT": "low",
    // Daily caps; the lexicon scorer takes over when one is reached. At GLM-5.3 list prices
    // ($1.40/M input, $4.40/M output) these cap spend at about $8.60 a day.
    "LLM_DAILY_INPUT_TOKEN_BUDGET": "3000000",
    "LLM_DAILY_OUTPUT_TOKEN_BUDGET": "1000000",
    "CAPITAL_INR": "500000",
    // Indices the engine trades, comma-separated: "NIFTY,SENSEX" trades both. Both share the daily limits.
    "INDICES": "NIFTY,SENSEX",
    // Most positions open at once on one index (1 to 3). They share the 4-entries-a-day and loss limits.
    "MAX_OPEN_PER_INDEX": "2",
    // Most entries per day across the indices (1 to 12). The 2-losses-in-a-row halt and the daily loss cap still apply.
    "MAX_TRADES_PER_DAY": "8",
    // Paper accounts to run, comma-separated; main is always on. "small10k" and "small5k" add the
    // ₹10,000 and ₹5,000 accounts that follow main's signals with one cheaper out-of-the-money lot
    // (src/engine/accounts.ts).
    "ACCOUNTS": "main,small10k,small5k",
    // Edge gate for every account: "calibrated" re-runs the edge check on measured index moves and
    // realized volatility (reports/wp2-wp5-gates.md). On today's signals it blocks every entry, so it
    // pauses buying until a signal earns its decay and costs (owner's decision, 9 Oct 2026).
    // "legacy" (or unset) restores the original gate.
    "EDGE_GATE": "calibrated",
    // Dashboard base URL for the links in copy-trade alerts (empty: no links).
    "DASHBOARD_URL": "https://ruphak-dashboard.sanjaysenthilkumar.workers.dev"
  },
  "env": {
    "preview": {
      "name": "ruphak-engine-preview",
      "vars": {
        "ENGINE_ENV": "preview",
        "LIVE_TRADING": "false",
        "GROWW_DATA_VIA_RELAY": "false",
        "LLM_PROVIDER": "workers-ai",
        "LLM_MODEL": "@cf/zai-org/glm-5.3",
        "LLM_EFFORT": "low",
        "LLM_DAILY_INPUT_TOKEN_BUDGET": "300000",
        "LLM_DAILY_OUTPUT_TOKEN_BUDGET": "100000",
        "CAPITAL_INR": "500000",
        "INDICES": "NIFTY,SENSEX",
        "MAX_OPEN_PER_INDEX": "1",
        "MAX_TRADES_PER_DAY": "4",
        "ACCOUNTS": "main,small10k,small5k",
        "EDGE_GATE": "calibrated",
        "DASHBOARD_URL": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ruphak-trading-preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "00000000000000000000000000000001" }],
      "queues": {
        "producers": [{ "binding": "SCORE_QUEUE", "queue": "events-to-score-preview" }],
        "consumers": [
          {
            "queue": "events-to-score-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 20,
            "max_retries": 3,
            "dead_letter_queue": "events-to-score-preview-dlq"
          },
          { "queue": "events-to-score-preview-dlq", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 1 }
        ]
      },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "ENGINE_DO", "class_name": "TradingEngineDO" },
          { "name": "INGEST_DO", "class_name": "IngestDO" },
          { "name": "BACKTEST_DO", "class_name": "BacktestDO" }
        ]
      },
      "triggers": { "crons": ["*/30 * * * *"] }
    }
  }
}
