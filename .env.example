# Dashboard (next dev). Copy to .env.local.
# 1 = always use the built-in mock engine data (no Cloudflare needed); 0 = call the engine Worker.
ENGINE_MOCK=1
# 1 = make the mock repository fail, to see the stale/offline UI states.
ENGINE_MOCK_FAIL=0
# Admin token for arm / kill switch / mode routes (must match the engine Worker's ADMIN_TOKEN).
ADMIN_TOKEN=dev
# Existing optional keys for the metals terminal.
NEXT_PUBLIC_GNEWS_API_KEY=
GOLD_API_KEY=
